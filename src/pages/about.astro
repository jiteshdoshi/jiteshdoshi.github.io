---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="About"
  description="Learn about Jitesh Doshi — AI scientist, nature explorer, and educator working at the intersection of machine learning and drug discovery."
>

  <!-- ── PAGE HEADER ────────────────────────────────────────── -->
  <section class="page-hero">
    <div class="container">
      <span class="section-label">About me</span>
      <h1>Scientist. Explorer.<br/>Perpetually curious.</h1>
      <p class="page-sub">
        I work on hard problems at the intersection of AI and medicine — and spend the rest of my time walking up mountains.
      </p>
    </div>
  </section>

  <!-- ── BIO ───────────────────────────────────────────────── -->
  <section class="section">
    <div class="container about-grid">

      <div class="about-photo-col">
        <div class="photo-frame">
          <img src="/images/Peptris_Jitesh_Photo.jpg" alt="Jitesh Doshi" />
        </div>
        <div class="about-quick">
          <div class="quick-item">
            <span class="quick-label">Based in</span>
            <span>Bengaluru, India</span>
          </div>
          <div class="quick-item">
            <span class="quick-label">Currently</span>
            <span>Senior Research Scientist, Peptris Technologies</span>
          </div>
          <div class="quick-item">
            <span class="quick-label">Background</span>
            <span>MSc Bioinformatics, Savitribai Phule Pune University</span>
          </div>
          <div class="quick-item">
            <span class="quick-label">Open to</span>
            <span>Consulting, speaking, collaborations</span>
          </div>
        </div>
      </div>

      <div class="about-bio prose">
        <p style="font-size:1.15rem; line-height:1.75; color: var(--text);">
          I'm Jitesh Doshi — a Senior Research Scientist at <strong>Peptris Technologies</strong> in Bengaluru,
          working at the intersection of AI, cheminformatics, and drug discovery. And someone who finds equal meaning in the rhythm of a long trail.
        </p>
        <p>
          My career spans 15+ years across research, education, and industry. I started out in structural bioinformatics —
          running molecular dynamics simulations on HPC clusters, building protein databases, and teaching biologists how to use
          computational tools. Over time, that foundation evolved into a deep focus on machine learning for molecular science.
        </p>
        <p>
          At Peptris, I lead AI-driven drug discovery initiatives — building generative models, ML-guided virtual screening pipelines,
          and end-to-end cheminformatics workflows. Before joining Peptris, I founded and ran <strong>BioInsight Solutions</strong>,
          a bioinformatics training and consultancy venture based in Navi Mumbai. I also ran bioinformatics workshops across India in
          association with IITs through MakeIntern, trained hundreds of students, and worked as a research fellow at Tata Memorial Centre (ACTREC).
        </p>
        <p>
          Teaching has always been part of my identity. Whether it's a formal workshop at an IIT-affiliated college,
          a YouTube video on molecular docking, or a blog post about generative AI — I believe scientific knowledge
          belongs in the hands of as many curious people as possible.
        </p>
        <p>
          Outside the lab, I'm a nature enthusiast, hiker, and explorer. The Western Ghats, the Himalayas,
          and the quieter corners of the Indian subcontinent keep me grounded. This site is where I bring all of it together.
        </p>
      </div>

    </div>
  </section>

  <!-- ── TIMELINE ───────────────────────────────────────────── -->
  <section class="section" style="background: var(--bg-surface);">
    <div class="container">
      <span class="section-label">Journey</span>
      <h2>A rough timeline</h2>

      <div class="timeline" style="margin-top:2.5rem; max-width: 680px;">

        <div class="timeline-item">
          <div class="timeline-year">Apr 2024 – Present</div>
          <div class="timeline-title">Senior Research Scientist — Peptris Technologies</div>
          <div class="timeline-sub">Bengaluru, India</div>
          <p style="color: var(--text-muted); font-size:0.9rem; margin:0;">
            Leading AI-driven drug discovery: generative models, structure-based design, ML-guided hit identification, and end-to-end computational pipelines.
          </p>
        </div>

        <div class="timeline-item">
          <div class="timeline-year">Feb 2022 – Mar 2024</div>
          <div class="timeline-title">Research Scientist — Peptris Technologies</div>
          <div class="timeline-sub">Bengaluru, India</div>
          <p style="color: var(--text-muted); font-size:0.9rem; margin:0;">
            ML models for molecular property prediction, virtual screening, and cheminformatics pipeline development.
          </p>
        </div>

        <div class="timeline-item">
          <div class="timeline-year">Sep 2020 – Jan 2022</div>
          <div class="timeline-title">Founder &amp; Director — BioInsight Solutions (OPC) Pvt. Ltd.</div>
          <div class="timeline-sub">Kharghar, Navi Mumbai</div>
          <p style="color: var(--text-muted); font-size:0.9rem; margin:0;">
            Founded and ran a bioinformatics training, research support, and consultancy venture; wound down in Jan 2022 to join Peptris full-time.
          </p>
        </div>

        <div class="timeline-item">
          <div class="timeline-year">2017 – 2022</div>
          <div class="timeline-title">Workshop Mentor — MakeIntern</div>
          <div class="timeline-sub">Pan-India (in association with IITs)</div>
          <p style="color: var(--text-muted); font-size:0.9rem; margin:0;">
            Teaching cheminformatics, bioinformatics, and CADD to students across India through IIT-affiliated workshops.
          </p>
        </div>

        <div class="timeline-item">
          <div class="timeline-year">2016 – 2018</div>
          <div class="timeline-title">Bioinformatics Research Fellow — Tata Memorial Centre (ACTREC)</div>
          <div class="timeline-sub">Navi Mumbai</div>
          <p style="color: var(--text-muted); font-size:0.9rem; margin:0;">
            Molecular modelling and MD simulations of oncology proteins on HPC clusters; CADD for inhibitor design; database and web application development.
          </p>
        </div>

        <div class="timeline-item">
          <div class="timeline-year">2014</div>
          <div class="timeline-title">Graduate Student &amp; Teaching Assistant</div>
          <div class="timeline-sub">University of Illinois at Chicago</div>
          <p style="color: var(--text-muted); font-size:0.9rem; margin:0;">
            Teaching biochemistry discussions; IT infrastructure and web development (Perl, ASP).
          </p>
        </div>

        <div class="timeline-item">
          <div class="timeline-year">2012 – 2013</div>
          <div class="timeline-title">Research Associate — Bioinformatics Center, University of Pune</div>
          <div class="timeline-sub">DBT Centre of Excellence project</div>
          <p style="color: var(--text-muted); font-size:0.9rem; margin:0;">
            Molecular docking and dynamics for p38 MAP kinase; epitope stability analysis for vaccine target design.
          </p>
        </div>

        <div class="timeline-item">
          <div class="timeline-year">2009 – 2011</div>
          <div class="timeline-title">MSc, Bioinformatics — Savitribai Phule Pune University</div>
          <div class="timeline-sub">Bioinformatics Centre · Foundation in computational biology</div>
          <p style="color: var(--text-muted); font-size:0.9rem; margin:0;">
            Where the computational science journey began — and the first treks.
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- ── WHAT DRIVES ME ────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <span class="section-label">Values</span>
      <h2>What drives me</h2>

      <div class="grid-3" style="margin-top:2rem;">

        <div class="card values-card">
          <div class="pillar-icon teal" style="margin-bottom:1rem;">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
          </div>
          <h3>Rigour with openness</h3>
          <p style="color: var(--text-muted); font-size:0.9rem; margin:0;">
            Good science demands precision. It also demands willingness to be wrong. I try to hold both simultaneously.
          </p>
        </div>

        <div class="card values-card">
          <div class="pillar-icon accent" style="margin-bottom:1rem;">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <h3>Knowledge wants to move</h3>
          <p style="color: var(--text-muted); font-size:0.9rem; margin:0;">
            Research locked in journals doesn't help anyone. I believe in translating what I learn into accessible writing, videos, and conversations.
          </p>
        </div>

        <div class="card values-card">
          <div class="pillar-icon teal" style="margin-bottom:1rem;">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polygon points="3 11 22 2 13 21 11 13 3 11"/></svg>
          </div>
          <h3>Nature as teacher</h3>
          <p style="color: var(--text-muted); font-size:0.9rem; margin:0;">
            Time in wild places resets my relationship to uncertainty and scale. The mountains ask questions that the lab never does.
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- ── CURRENTLY ──────────────────────────────────────────── -->
  <section class="section section-sm" style="background: var(--bg-surface);">
    <div class="container">
      <span class="section-label">Right now</span>
      <h2>Currently</h2>

      <div class="currently-grid">

        <div class="currently-item">
          <span class="currently-icon">🔬</span>
          <div>
            <strong>Working on</strong>
            <p>AI-driven drug discovery at Peptris · Building courses on cheminformatics &amp; CADD for the wider community</p>
          </div>
        </div>

        <div class="currently-item">
          <span class="currently-icon">📺</span>
          <div>
            <strong>Creating</strong>
            <p>YouTube videos on computational drug discovery, molecular docking, and AI in life sciences</p>
          </div>
        </div>

        <div class="currently-item">
          <span class="currently-icon">🗺️</span>
          <div>
            <strong>Exploring</strong>
            <p>Nature trails across India — the Western Ghats, the Himalayas, and everything in between</p>
          </div>
        </div>

        <div class="currently-item">
          <span class="currently-icon">📚</span>
          <div>
            <strong>Reading &amp; learning</strong>
            <p>Latest papers in generative molecular design · Structural bioinformatics · Science communication</p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ── CTA ───────────────────────────────────────────────── -->
  <section class="section-sm">
    <div class="container" style="text-align:center;">
      <p style="color: var(--text-muted); margin-bottom:1.25rem; font-size:1.05rem;">Want to work together or just say hello?</p>
      <a href="/connect" class="btn btn-primary">Get in touch</a>
    </div>
  </section>

</BaseLayout>

<style>
  .page-hero {
    padding: 5rem 0 3rem;
    background:
      radial-gradient(ellipse 70% 50% at 80% 20%, rgba(15,118,110,0.06) 0%, transparent 60%),
      var(--bg);
  }

  .page-sub {
    font-size: 1.1rem;
    color: var(--text-muted);
    max-width: 52ch;
    margin-top: 0.75rem;
  }

  /* Bio layout */
  .about-grid {
    display: grid;
    grid-template-columns: 230px 1fr;
    gap: 4rem;
    align-items: start;
  }

  @media (max-width: 768px) {
    .about-grid { grid-template-columns: 1fr; gap: 2rem; }
  }

  .photo-frame {
    width: 100%;
    aspect-ratio: 3/4;
    background: var(--bg-surface-2);
    border-radius: var(--radius-lg);
    overflow: hidden;
    margin-bottom: 1.5rem;
  }

  .photo-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .about-quick {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .quick-item {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border);
    font-size: 0.9rem;
  }

  .quick-item:last-child { border-bottom: none; }

  .quick-label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-subtle);
  }

  /* Values cards */
  .values-card {
    display: flex;
    flex-direction: column;
  }

  .values-card h3 { margin-bottom: 0.5rem; }

  /* Currently */
  .currently-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin-top: 2rem;
  }

  @media (max-width: 600px) {
    .currently-grid { grid-template-columns: 1fr; }
  }

  .currently-item {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 1.25rem;
  }

  .currently-icon {
    font-size: 1.5rem;
    flex-shrink: 0;
    line-height: 1;
    margin-top: 0.1rem;
  }

  .currently-item strong {
    display: block;
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 0.25rem;
  }

  .currently-item p {
    font-size: 0.875rem;
    color: var(--text-muted);
    margin: 0;
  }
</style>
