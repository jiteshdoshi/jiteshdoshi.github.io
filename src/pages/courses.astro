---
import BaseLayout from '../layouts/BaseLayout.astro';

const courses = [
  {
    title: "Introduction to Computational Drug Discovery",
    description: "A practical, from-scratch introduction to the computational tools and concepts used in modern drug discovery — from target biology to hit identification.",
    level: "Beginner",
    duration: "6 hours",
    modules: 8,
    status: "coming-soon",
    price: "Free",
    tags: ["Drug Discovery", "Python", "RDKit"],
  },
  {
    title: "Generative AI for Molecular Design",
    description: "Deep-dive into diffusion models, graph neural networks, and flow-matching approaches for de novo molecular generation. Hands-on PyTorch throughout.",
    level: "Advanced",
    duration: "10 hours",
    modules: 12,
    status: "coming-soon",
    price: "Paid",
    tags: ["PyTorch", "Generative Models", "Diffusion"],
  },
  {
    title: "ADMET Prediction with Machine Learning",
    description: "Build and evaluate ML models for predicting absorption, distribution, metabolism, excretion, and toxicity properties of drug candidates.",
    level: "Intermediate",
    duration: "5 hours",
    modules: 7,
    status: "coming-soon",
    price: "Free",
    tags: ["ADMET", "Scikit-learn", "Cheminformatics"],
  },
  {
    title: "In-Depth Molecular Docking",
    description: "A comprehensive, hands-on course on structure-based virtual screening — receptor and ligand preparation, grid/search-space setup, docking with AutoDock Vina, and rigorous results analysis.",
    level: "Intermediate",
    duration: "8 hours",
    modules: 9,
    status: "coming-soon",
    price: "Paid",
    tags: ["Molecular Docking", "AutoDock Vina", "CADD"],
  },
  {
    title: "In-Depth Molecular Dynamics Simulations with GROMACS",
    description: "From system setup to production runs and trajectory analysis — a complete, practical guide to running protein-ligand molecular dynamics simulations in GROMACS.",
    level: "Intermediate",
    duration: "10 hours",
    modules: 11,
    status: "coming-soon",
    price: "Paid",
    tags: ["GROMACS", "Molecular Dynamics", "Simulation"],
  },
];

const levelColor: Record<string, string> = {
  Beginner: 'tag-teal',
  Intermediate: 'tag-accent',
  Advanced: 'tag-neutral',
};
---

<BaseLayout
  title="Courses"
  description="Courses on computational drug discovery, generative AI for molecules, and machine learning for biology by Jitesh Doshi."
>

  <section class="page-hero">
    <div class="container">
      <span class="section-label">Learn</span>
      <h1>Courses</h1>
      <p class="page-sub">
        Practical, code-first courses on AI and computational drug discovery — for scientists who want to build real things.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">

      <!-- Value prop -->
      <div class="courses-intro grid-3" style="margin-bottom:3.5rem;">
        <div class="intro-item">
          <div class="pillar-icon teal" style="margin-bottom:0.75rem;">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
          </div>
          <strong>Code-first</strong>
          <p>Every concept illustrated with working Python code. No theory without practice.</p>
        </div>
        <div class="intro-item">
          <div class="pillar-icon accent" style="margin-bottom:0.75rem;">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3H5a2 2 0 0 0-2 2v4m6-6h10a2 2 0 0 1 2 2v4M9 3v11m0 0H5a2 2 0 0 1-2-2V9m6 5h10a2 2 0 0 0 2-2V9m0 0H5"/></svg>
          </div>
          <strong>Research-grounded</strong>
          <p>Drawn from real workflows in drug discovery — not textbook examples.</p>
        </div>
        <div class="intro-item">
          <div class="pillar-icon teal" style="margin-bottom:0.75rem;">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          </div>
          <strong>Self-paced</strong>
          <p>Work through material at your own speed. All content available immediately on enrolment.</p>
        </div>
      </div>

      <!-- Course cards -->
      <div style="display:flex; flex-direction:column; gap:1.5rem;">
        {courses.map(course => (
          <div class="course-card card">
            <div class="course-card-inner">
              <div class="course-main">
                <div class="course-meta-row">
                  <span class={`tag ${levelColor[course.level] || 'tag-neutral'}`}>{course.level}</span>
                  <span class={`tag ${course.price === 'Free' ? 'tag-teal' : 'tag-accent'}`}>{course.price}</span>
                  <span class="tag tag-neutral">{course.status === 'coming-soon' ? 'Coming soon' : 'Available'}</span>
                </div>
                <h3 class="course-title">{course.title}</h3>
                <p class="course-desc">{course.description}</p>
                <div class="course-stats">
                  <span>
                    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    {course.duration}
                  </span>
                  <span>
                    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
                    {course.modules} modules
                  </span>
                </div>
                <div style="display:flex; flex-wrap:wrap; gap:0.4rem; margin-top:0.75rem;">
                  {course.tags.map(t => <span class="tag tag-neutral" style="font-size:0.7rem;">{t}</span>)}
                </div>
              </div>
              <div class="course-action">
                {course.status === 'coming-soon' ? (
                  <button class="btn btn-secondary" disabled style="cursor:not-allowed; opacity:0.6;">
                    Notify me
                  </button>
                ) : (
                  <a href="/connect" class="btn btn-primary">Enrol now</a>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- CTA -->
      <div class="newsletter-band" style="margin-top:4rem;">
        <span class="section-label">Stay updated</span>
        <h2 style="margin:0.5rem 0 0.75rem;">Get notified when courses launch</h2>
        <p style="color:var(--text-muted); max-width:46ch; margin:0 auto 1.5rem;">
          I'll email you when a new course goes live. No spam — just a single note per launch.
        </p>
        <form class="newsletter-form" onsubmit="return false;">
          <input type="email" placeholder="your@email.com" aria-label="Email address" />
          <button type="submit" class="btn btn-primary">Notify me</button>
        </form>
      </div>

    </div>
  </section>

</BaseLayout>

<style>
  .page-hero {
    padding: 5rem 0 3rem;
    background:
      radial-gradient(ellipse 70% 50% at 70% 40%, rgba(184,134,11,0.07) 0%, transparent 60%),
      var(--bg);
  }
  .page-sub { font-size:1.1rem; color:var(--text-muted); max-width:52ch; margin-top:0.75rem; }

  .intro-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .intro-item strong {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.95rem;
  }

  .intro-item p {
    font-size: 0.875rem;
    color: var(--text-muted);
    margin: 0;
  }

  /* Course cards */
  .course-card-inner {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .course-main { flex: 1; min-width: 0; }

  .course-meta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 0.75rem;
  }

  .course-title {
    font-size: 1.15rem;
    margin-bottom: 0.5rem;
  }

  .course-desc {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin: 0;
    max-width: 60ch;
  }

  .course-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 0.875rem;
    font-size: 0.82rem;
    color: var(--text-subtle);
  }

  .course-stats span {
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }

  .course-action {
    flex-shrink: 0;
    padding-top: 0.25rem;
  }
</style>
