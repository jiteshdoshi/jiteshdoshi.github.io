---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Connect"
  description="Get in touch with Jitesh Doshi — available for consulting, speaking, collaborations, and general conversation about AI, drug discovery, and the outdoors."
>

  <!-- ── HEADER ─────────────────────────────────────────────── -->
  <section class="page-hero">
    <div class="container">
      <span class="section-label">Let's talk</span>
      <h1>Connect with me</h1>
      <p class="page-sub">
        Whether it's a research collaboration, a speaking invitation, or just something you read that you want to push back on — I'm interested.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container connect-layout">

      <!-- LEFT: form + social -->
      <div class="connect-main">

        <!-- Social links -->
        <div style="margin-bottom:2.5rem;">
          <h2 style="font-size:1.2rem; margin-bottom:1.25rem;">Find me on</h2>
          <div class="social-cards">

            <a href="https://github.com/jiteshdoshi" target="_blank" rel="noopener" class="social-card">
              <div class="social-card-icon" style="background: #24292e; color: #fff;">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
              </div>
              <div>
                <strong>GitHub</strong>
                <span>github.com/jiteshdoshi</span>
              </div>
              <svg class="social-arrow" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg>
            </a>

            <a href="https://www.linkedin.com/in/jiteshvdoshi/" target="_blank" rel="noopener" class="social-card">
              <div class="social-card-icon" style="background: #0077b5; color: #fff;">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
              </div>
              <div>
                <strong>LinkedIn</strong>
                <span>linkedin.com/in/jiteshvdoshi</span>
              </div>
              <svg class="social-arrow" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg>
            </a>

            <a href="https://www.youtube.com/@jiteshvdoshi" target="_blank" rel="noopener" class="social-card">
              <div class="social-card-icon" style="background: #ff0000; color: #fff;">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
              </div>
              <div>
                <strong>YouTube</strong>
                <span>youtube.com/@jiteshvdoshi</span>
              </div>
              <svg class="social-arrow" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg>
            </a>

            <a href="mailto:jiteshvdoshi@gmail.com" class="social-card">
              <div class="social-card-icon" style="background: var(--accent); color: #fff;">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              </div>
              <div>
                <strong>Email</strong>
                <span>jiteshvdoshi@gmail.com</span>
              </div>
              <svg class="social-arrow" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg>
            </a>

          </div>
        </div>

        <!-- Contact form -->
        <div>
          <h2 style="font-size:1.2rem; margin-bottom:0.5rem;">Send a message</h2>
          <p style="color: var(--text-muted); font-size:0.9rem; margin-bottom:1.5rem;">
            I read every message and reply to most. For consulting enquiries, please mention your timeline and scope.
          </p>

          <!-- Connect this form to Formspree, Netlify Forms, or similar -->
          <form class="contact-form" action="https://formspree.io/f/YOUR_FORM_ID" method="POST">
            <div class="form-row">
              <div class="form-group">
                <label class="form-label" for="name">Name</label>
                <input class="form-input" type="text" id="name" name="name" placeholder="Your name" required />
              </div>
              <div class="form-group">
                <label class="form-label" for="email">Email</label>
                <input class="form-input" type="email" id="email" name="email" placeholder="your@email.com" required />
              </div>
            </div>

            <div class="form-group">
              <label class="form-label" for="subject">Subject</label>
              <select class="form-select" id="subject" name="subject">
                <option value="">Choose a topic…</option>
                <option value="consulting">Consulting enquiry</option>
                <option value="speaking">Speaking invitation</option>
                <option value="collaboration">Research collaboration</option>
                <option value="courses">Courses &amp; learning</option>
                <option value="other">Just saying hello</option>
              </select>
            </div>

            <div class="form-group">
              <label class="form-label" for="message">Message</label>
              <textarea class="form-textarea" id="message" name="message" placeholder="What's on your mind?" required></textarea>
            </div>

            <button type="submit" class="btn btn-primary" style="width:100%;">
              Send message
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
            </button>

            <p style="font-size:0.78rem; color:var(--text-subtle); margin-top:0.75rem; text-align:center;">
              Form powered by Formspree — replace the action URL with your form endpoint.
            </p>
          </form>
        </div>

      </div>

      <!-- RIGHT: work with me -->
      <aside class="connect-aside">

        <div class="card" style="margin-bottom:1.5rem;">
          <span class="section-label" style="margin-bottom:0.75rem;">Availability</span>
          <div style="display:flex; align-items:center; gap:0.5rem; margin-bottom:0.75rem;">
            <span style="width:10px; height:10px; border-radius:50%; background: #22c55e; display:inline-block;"></span>
            <span style="font-weight:600; font-size:0.95rem; color: var(--text);">Open to opportunities</span>
          </div>
          <p style="font-size:0.875rem; color:var(--text-muted); margin:0;">
            Currently taking on selective consulting and advisory engagements. Response time: 1–3 business days.
          </p>
        </div>

        <div class="work-with-me">
          <h3 style="font-size:1rem; margin-bottom:1.25rem;">Work with me</h3>

          <div class="wm-item">
            <div class="wm-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
            </div>
            <div>
              <strong>Consulting</strong>
              <p>AI/ML strategy, generative chemistry, pipeline architecture, and literature reviews for drug discovery organisations.</p>
            </div>
          </div>

          <div class="wm-item">
            <div class="wm-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            </div>
            <div>
              <strong>Speaking</strong>
              <p>Conference talks, webinars, and podcasts on AI for drug discovery, generative chemistry, and computational biology.</p>
            </div>
          </div>

          <div class="wm-item">
            <div class="wm-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
            <div>
              <strong>Collaboration</strong>
              <p>Research partnerships, co-authorship on papers, and open-source tool development in computational drug discovery.</p>
            </div>
          </div>

          <div class="wm-item">
            <div class="wm-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
            </div>
            <div>
              <strong>Teaching &amp; Workshops</strong>
              <p>Hands-on training for teams wanting to adopt ML and generative AI in their research workflows.</p>
            </div>
          </div>

        </div>

      </aside>

    </div>
  </section>

</BaseLayout>

<style>
  .page-hero {
    padding: 5rem 0 3rem;
    background:
      radial-gradient(ellipse 70% 50% at 30% 70%, rgba(15,118,110,0.06) 0%, transparent 60%),
      var(--bg);
  }

  .page-sub {
    font-size: 1.1rem;
    color: var(--text-muted);
    max-width: 52ch;
    margin-top: 0.75rem;
  }

  .connect-layout {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 4rem;
    align-items: start;
  }

  @media (max-width: 860px) {
    .connect-layout { grid-template-columns: 1fr; }
    .connect-aside { order: -1; }
  }

  /* Social cards */
  .social-cards {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .social-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.875rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg-surface);
    text-decoration: none;
    color: var(--text);
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
  }

  .social-card:hover {
    border-color: var(--accent);
    box-shadow: var(--shadow-sm);
    transform: translateX(3px);
  }

  .social-card-icon {
    width: 42px;
    height: 42px;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .social-card > div:nth-child(2) {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .social-card strong {
    font-family: var(--font-display);
    font-size: 0.95rem;
  }

  .social-card span {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .social-arrow {
    color: var(--text-subtle);
    flex-shrink: 0;
  }

  /* Contact form */
  .contact-form { max-width: 100%; }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  @media (max-width: 500px) {
    .form-row { grid-template-columns: 1fr; }
  }

  /* Work with me */
  .work-with-me {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
  }

  .wm-item {
    display: flex;
    gap: 0.875rem;
    padding: 0.875rem 0;
    border-bottom: 1px solid var(--border);
    align-items: flex-start;
  }

  .wm-item:last-child { border-bottom: none; padding-bottom: 0; }

  .wm-icon {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-sm);
    background: var(--teal-light);
    color: var(--teal);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .wm-item strong {
    display: block;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--text);
    margin-bottom: 0.2rem;
  }

  .wm-item p {
    font-size: 0.82rem;
    color: var(--text-muted);
    margin: 0;
    line-height: 1.5;
  }
</style>
